# Listener
HOST=0.0.0.0
PORT=8787

# MongoDB is optional. The server serves seed/cached state and retries when it is unavailable.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=netgoat
POLL_INTERVAL=5000
MONGO_RETRY_INTERVAL=10000

# Configure at least one read key. Keep ALLOW_UNAUTHENTICATED=false in shared environments.
API_KEY=replace-with-a-long-random-key
DIAMOND_KEY=
CONFIG_WRITE_KEY=replace-with-a-different-long-random-key
ALLOW_UNAUTHENTICATED=false

# Local fallback
SEED_FILE=./seed-data.json
LOG_LEVEL=info
